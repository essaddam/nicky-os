  "components": {
    "schemas": {
      "Generation": {
        "type": "integer",
        "minimum": 1,
        "maximum": 18446744073709551615
      },
      "Start": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "Submit": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "generation",
          "code"
        ],
        "properties": {
          "generation": {
            "$ref": "#/components/schemas/Generation"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{6}$",
            "writeOnly": true,
            "description": "Code de télévision éphémère, jamais un PIN Moli."
          }
        }
      },
      "Cancel": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "generation"
        ],
        "properties": {
          "generation": {
            "$ref": "#/components/schemas/Generation"
          }
        }
      },
      "PairingView": {
        "type": "object",
        "required": [
          "phase",
          "generation",
          "expires_at",
          "error",
          "message"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "unavailable",
              "idle",
              "preparing",
              "awaiting_code",
              "verifying",
              "persisting",
              "paired",
              "failed"
            ]
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "expires_at": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Échéance humaine absolue, millisecondes Unix."
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "unavailable",
              "busy",
              "stale",
              "invalid_code",
              "refused",
              "expired",
              "network",
              "vault"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Explication traduite de l’erreur, sans donnée saisie."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Message traduit contrôlé."
          },
          "code": {
            "type": "string"
          }
        }
      }
    }
