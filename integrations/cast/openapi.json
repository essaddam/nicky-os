{
  "openapi": "3.1.0",
  "info": {
    "title": "Activation explicite Cast",
    "version": "1.0.0",
    "description": "Mêmes protections Host, origine, session humaine et invité que les autres routes Moli. Mutation limitée à 1024 octets, sans hôte ni pin fourni par HTTP."
  },
  "paths": {
    "/api/integrations/cast/{instance}": {
      "get": {
        "operationId": "castState",
        "summary": "Lire la sélection sans découverte ni activation",
        "responses": {
          "200": {
            "description": "État public après opération",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/View"
                }
              }
            }
          },
          "403": {
            "description": "Foyer humain avec PIN requis, invité ou démo refusé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Instance activée inconnue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "instance",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/integrations/cast/{instance}/discovery": {
      "post": {
        "operationId": "castDiscover",
        "summary": "Rechercher explicitement des candidats ; aucun appareil publié",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [],
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "État public après opération",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/View"
                }
              }
            }
          },
          "403": {
            "description": "Foyer humain avec PIN requis, invité ou démo refusé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Instance activée inconnue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Occupation, propriété ou génération périmée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Corps supérieur à 1024 octets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "JSON fermé ou candidat invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "Découverte réseau échouée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Passerelle ou coffre indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "instance",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    },
    "/api/integrations/cast/{instance}/activation": {
      "put": {
        "operationId": "castApprove",
        "summary": "Valider la génération exacte et persister avant publication",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "generation",
                  "candidate",
                  "exclusive"
                ],
                "properties": {
                  "generation": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  },
                  "candidate": {
                    "type": "string",
                    "maxLength": 32
                  },
                  "exclusive": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "État public après opération",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/View"
                }
              }
            }
          },
          "403": {
            "description": "Foyer humain avec PIN requis, invité ou démo refusé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Instance activée inconnue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Occupation, propriété ou génération périmée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Corps supérieur à 1024 octets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "JSON fermé ou candidat invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "Découverte réseau échouée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Passerelle ou coffre indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "castRevoke",
        "summary": "Retirer la sélection et persister sa révocation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "generation"
                ],
                "properties": {
                  "generation": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "État public après opération",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/View"
                }
              }
            }
          },
          "403": {
            "description": "Foyer humain avec PIN requis, invité ou démo refusé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Instance activée inconnue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Occupation, propriété ou génération périmée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Corps supérieur à 1024 octets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "JSON fermé ou candidat invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "502": {
            "description": "Découverte réseau échouée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Passerelle ou coffre indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "parameters": [
        {
          "name": "instance",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ]
    }
  },
  "components": {
    "schemas": {
      "Candidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "host",
          "hostname",
          "video"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 32
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "host": {
            "type": "string",
            "format": "ipv4"
          },
          "hostname": {
            "type": "string",
            "maxLength": 253
          },
          "video": {
            "type": "boolean"
          }
        }
      },
      "View": {
        "type": "object",
        "required": [
          "phase",
          "generation",
          "candidates",
          "error",
          "message"
        ],
        "properties": {
          "phase": {
            "type": "string",
            "enum": [
              "unavailable",
              "idle",
              "discovering",
              "ready",
              "persisting",
              "active",
              "failed"
            ]
          },
          "generation": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "candidates": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "code",
          "error"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
